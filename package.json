{
  "name": "puzzlevidio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Prototype: turn your own photos into jigsaw-style puzzles in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "server": "tsx server/src/local.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1159.0",
    "@aws-sdk/client-dynamodb": "^3.1159.0",
    "@aws-sdk/client-iot": "^3.1159.0",
    "@aws-sdk/client-iot-data-plane": "^3.1159.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-secrets-manager": "^3.1159.0",
    "@aws-sdk/lib-dynamodb": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "qrcode-generator": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "ws": "^8.22.0"
  }
